<UserControl
    x:Class="Lexicom.Concentrate.Wpf.Controls.HintTextBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="lccHintTextBox"
    VerticalContentAlignment="Center"
    d:DesignHeight="32"
    d:DesignWidth="128"
    Focusable="True">

    <UserControl.Template>
        <ControlTemplate TargetType="UserControl">
            <Border
                x:Name="lccBorder"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{Binding CornerRadius, ElementName=lccHintTextBox}"
                IsEnabled="{TemplateBinding IsEnabled}"
                IsHitTestVisible="{TemplateBinding IsHitTestVisible}"
                ToolTip="{TemplateBinding ToolTip}">

                <Grid x:Name="lccGrid">
                    <!--
                        Because the internal textbox has a 2 pixel left padding built in for the aero theme
                        we need to hardcode a 2 pixel left margin on the textblock so it lines up unfortunatly
                    -->
                    <TextBlock
                        x:Name="lccHintTextBlock"
                        Margin="2,0,0,0"
                        Padding="{Binding HintPadding, ElementName=lccHintTextBox}"
                        HorizontalAlignment="{Binding HintHorizontalAlignment, ElementName=lccHintTextBox}"
                        VerticalAlignment="{Binding HintVerticalAlignment, ElementName=lccHintTextBox}"
                        Background="{x:Null}"
                        FlowDirection="{Binding HintFlowDirection, ElementName=lccHintTextBox}"
                        FontFamily="{Binding HintFontFamily, ElementName=lccHintTextBox}"
                        FontSize="{Binding HintFontSize, ElementName=lccHintTextBox}"
                        FontStretch="{Binding HintFontStretch, ElementName=lccHintTextBox}"
                        FontStyle="{Binding HintFontStyle, ElementName=lccHintTextBox}"
                        FontWeight="{Binding HintFontWeight, ElementName=lccHintTextBox}"
                        Foreground="{Binding HintForeground, ElementName=lccHintTextBox}"
                        IsHitTestVisible="False"
                        LineHeight="{Binding HintLineHeight, ElementName=lccHintTextBox}"
                        Opacity="{Binding HintOpacity, ElementName=lccHintTextBox}"
                        Text="{Binding HintText, ElementName=lccHintTextBox}"
                        TextAlignment="{Binding HintTextAlignment, ElementName=lccHintTextBox}"
                        TextTrimming="{Binding HintTextTrimming, ElementName=lccHintTextBox}"
                        TextWrapping="{Binding HintTextWrapping, ElementName=lccHintTextBox}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=lccHintTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=lccHintTextBox}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBox
                        x:Name="lccInputTextBox"
                        Margin="0"
                        Padding="0"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        AcceptsReturn="{Binding AcceptsReturn, ElementName=lccHintTextBox}"
                        AcceptsTab="{Binding AcceptsTab, ElementName=lccHintTextBox}"
                        AllowDrop="{TemplateBinding AllowDrop}"
                        Background="{x:Null}"
                        BorderBrush="{x:Null}"
                        BorderThickness="0"
                        CaretBrush="{Binding CaretBrush, ElementName=lccHintTextBox}"
                        CharacterCasing="{Binding CharacterCasing, ElementName=lccHintTextBox}"
                        ContextMenu="{TemplateBinding ContextMenu}"
                        FlowDirection="{TemplateBinding FlowDirection}"
                        Focusable="{TemplateBinding Focusable}"
                        FontFamily="{TemplateBinding FontFamily}"
                        FontSize="{TemplateBinding FontSize}"
                        FontStretch="{TemplateBinding FontStretch}"
                        FontStyle="{TemplateBinding FontStyle}"
                        FontWeight="{TemplateBinding FontWeight}"
                        Foreground="{TemplateBinding Foreground}"
                        GotFocus="InputTextBox_GotFocus"
                        HorizontalScrollBarVisibility="{Binding HorizontalScrollBarVisibility, ElementName=lccHintTextBox}"
                        IsEnabled="{TemplateBinding IsEnabled}"
                        IsInactiveSelectionHighlightEnabled="{Binding IsInactiveSelectionHighlightEnabled, ElementName=lccHintTextBox}"
                        IsReadOnly="{Binding IsReadOnly, ElementName=lccHintTextBox}"
                        IsReadOnlyCaretVisible="{Binding IsReadOnlyCaretVisible, ElementName=lccHintTextBox}"
                        IsTabStop="{TemplateBinding IsTabStop}"
                        IsUndoEnabled="{Binding IsUndoEnabled, ElementName=lccHintTextBox}"
                        Loaded="InputTextBox_Loaded"
                        LostFocus="InputTextBox_LostFocus"
                        MaxLength="{Binding MaxLength, ElementName=lccHintTextBox}"
                        MaxLines="{Binding MaxLines, ElementName=lccHintTextBox}"
                        MinLines="{Binding MinLines, ElementName=lccHintTextBox}"
                        SelectionBrush="{Binding SelectionBrush, ElementName=lccHintTextBox}"
                        SelectionOpacity="{Binding SelectionOpacity, ElementName=lccHintTextBox}"
                        SelectionTextBrush="{Binding SelectionTextBrush, ElementName=lccHintTextBox}"
                        TabIndex="{TemplateBinding TabIndex}"
                        Text="{Binding Text, ElementName=lccHintTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextAlignment="{Binding TextAlignment, ElementName=lccHintTextBox}"
                        TextWrapping="{Binding TextWrapping, ElementName=lccHintTextBox}"
                        UndoLimit="{Binding UndoLimit, ElementName=lccHintTextBox}"
                        VerticalScrollBarVisibility="{Binding VerticalScrollBarVisibility, ElementName=lccHintTextBox}" />
                </Grid>
            </Border>
        </ControlTemplate>
    </UserControl.Template>
</UserControl>
