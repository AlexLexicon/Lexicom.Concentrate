<Window
    x:Class="Lexicom.Concentrate.Wpf.Sandbox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lc_c="clr-namespace:Lexicom.Concentrate.Wpf.Controls;assembly=Lexicom.Concentrate.Wpf.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="clr-namespace:System;assembly=mscorlib"
    xmlns:sb="clr-namespace:Lexicom.Concentrate.Wpf.Sandbox"
    mc:Ignorable="d"
    Title="MainWindow"
    Width="800"
    Height="450"
    d:DataContext="{d:DesignInstance sb:MainWindowViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Border
            Grid.Row="0"
            Grid.Column="0"
            Margin="2,2,1,1"
            BorderBrush="Gray"
            BorderThickness="1">
            <StackPanel Margin="4,0">
                <TextBlock
                    Padding="0,8"
                    HorizontalAlignment="Center"
                    Text="Text Field Testing" />
                <lc_c:TextField
                    Key="name"
                    Margin="0,0,0,2"
                    KeyWidth="50"
                    Value="alex" />
                <lc_c:TextField
                    Key="age"
                    Margin="0,0,0,2"
                    KeyWidth="50"
                    Value="29" />
                <lc_c:TextField
                    Key="date"
                    Margin="0,0,0,2"
                    KeyWidth="50"
                    Value="5/22/2026" />
                <lc_c:TextField
                    Margin="0,0,0,2"
                    KeyWidth="50" />
            </StackPanel>
        </Border>
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Margin="2,1,1,2"
            BorderBrush="Gray"
            BorderThickness="1">
            <StackPanel Margin="4,0">
                <TextBlock
                    Padding="0,8"
                    HorizontalAlignment="Center"
                    Text="Hint TextBox Testing" />
                <lc_c:HintTextBox HintText="testing" />
            </StackPanel>
        </Border>
        <Border
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            Margin="1,2,2,2"
            BorderBrush="Gray"
            BorderThickness="1">
            <StackPanel Margin="4,0">
                <TextBlock
                    Padding="0,8"
                    HorizontalAlignment="Center"
                    Text="Text Input Testing" />
                <StackPanel
                    Height="24"
                    Margin="0,2"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding InvalidateCommand}"
                        Content="Give Error" />
                </StackPanel>
                <lc_c:TextInput
                    Title="Name"
                    Margin="0,0,0,2"
                    Validator="{Binding NameValidator}" />
                <lc_c:TextInput
                    Title="Age"
                    Margin="0,0,0,2">
                    <lc_c:TextInput.Errors>
                        <s:String>error example</s:String>
                    </lc_c:TextInput.Errors>
                </lc_c:TextInput>
                <lc_c:TextInput Margin="0,0,0,2" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
